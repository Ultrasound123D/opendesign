# Where opendesign stores settings/sessions/memory/catalog cache (default ~/.opendesign)
# OPENDESIGN_DATA_DIR=

# URL of the OpenFigma editor app that the default MCP server talks to
# (used only to seed Settings → MCP on first run)
# OPENFIGMA_API_URL=http://localhost:3111

# Provider API keys — any name from the models.dev catalog works, e.g.:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# ZHIPU_API_KEY=
# Or use the generic form for any provider:
# OPENDESIGN_<PROVIDER>_API_KEY=
